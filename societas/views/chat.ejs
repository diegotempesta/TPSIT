<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<script>
    window.currentUser = "<%= username %>";
</script>

<div class="container mt-4">
    <div class="row shadow rounded overflow-hidden" style="height: 75vh;">

        <!-- LISTA UTENTI -->
        <div class="col-4 bg-light border-end">
            <div class="p-3 border-bottom fw-bold">
                Chat
            </div>

            <div class="list-group list-group-flush">
                <% users.forEach(u => { %>
                    <button 
                        class="list-group-item list-group-item-action"
                        onclick="openChat('<%= u.username %>')"
                    >
                        <%= u.username %>
                    </button>
                <% }) %>
            </div>
        </div>

        <!-- CHAT -->
        <div class="col-8 d-flex flex-column h-100">

            <!-- HEADER -->
            <div class="p-3 border-bottom bg-white flex-shrink-0">
                <strong id="chatWith">Seleziona un utente</strong>
            </div>

            <!-- MESSAGGI -->
            <div 
                id="messages" 
                class="flex-grow-1 overflow-auto p-3 bg-light"
                style="min-height: 0;"
            ></div>

            <!-- INPUT -->
            <div class="p-3 border-top bg-white flex-shrink-0">
                <input 
                    id="messageInput" 
                    class="form-control"
                    placeholder="Scrivi un messaggio..."
                >
            </div>

        </div>
    </div>
</div>

<script src="/chat.js"></script>
</body>
</html>